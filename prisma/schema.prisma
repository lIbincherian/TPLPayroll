generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                    String    @id @default(uuid())
  employeeImportBatchId String?
  employeeId            String    @unique
  serialNumber          String?
  employeeName          String
  nationalId            String?
  designation           String
  dateOfJoining         DateTime?
  aadhaarId             String?
  policeVerificationId  String?
  phone                 String?
  dateOfBirth           DateTime?
  healthCardId          String?
  gPay                  String?
  bankAccount           String?
  dateOfResignation     DateTime?
  site                  String?
  isActive              Boolean   @default(true)
  designationShort      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  importBatch            EmployeeImportBatch?           @relation(fields: [employeeImportBatchId], references: [id])
  wageHistory            EmployeeWageHistory[]
  attendanceRecords      AttendanceRecord[]
  adjustments            PayrollAdjustment[]
  adjustmentApplications PayrollAdjustmentApplication[]
  payrollRunEmployees    PayrollRunEmployee[]
  invoiceSnapshots       InvoiceSnapshot[]
  documents              EmployeeDocument[]
  attendancePunches      AttendancePunch[]
  attendanceDecisions    AttendanceEmployeeDecision[]
  codeExceptions         AttendanceCodeException[]
}

model EmployeeImportBatch {
  id                          String    @id @default(uuid())
  fileName                    String
  fileType                    String
  status                      String
  importedAt                  DateTime  @default(now())
  importedRowCount            Int       @default(0)
  updatedEmployeeCount        Int       @default(0)
  createdEmployeeCount        Int       @default(0)
  rejectedRowCount            Int       @default(0)
  duplicateEmployeeIdRowCount Int       @default(0)
  sourceFileDeletedAt         DateTime?

  employees     Employee[]
  wageHistories EmployeeWageHistory[]
}

model EmployeeWageHistory {
  id                    String    @id @default(uuid())
  employeeId            String
  weeklySalary          Decimal   @db.Decimal(10, 2)
  hourlyRate            Decimal   @db.Decimal(10, 2)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  changeSource          String
  employeeImportBatchId String?
  changedBy             String?
  createdAt             DateTime  @default(now())

  employee    Employee             @relation(fields: [employeeId], references: [id])
  importBatch EmployeeImportBatch? @relation(fields: [employeeImportBatchId], references: [id])
}

model AttendanceUpload {
  id                     String    @id @default(uuid())
  fileName               String? // Excel era only
  fileType               String? // Excel era only
  payrollWeekStartDate   DateTime // UTC midnight Thursday
  payrollWeekEndDate     DateTime // UTC midnight Wednesday
  payrollWeekSource      String // Excel: SHEET_CONTENT|FILE_NAME|MANUAL; API weeks: 'ETIMEOFFICE'
  source                 String    @default("EXCEL") // 'EXCEL' | 'ETIMEOFFICE'
  status                 String // EXCEL: 'READY'|'ERRORS'; ETIMEOFFICE: 'SYNC_FAILED'|'REVIEW'|'APPROVED'
  isActiveForPayrollWeek Boolean   @default(true)
  uploadedBy             String?
  uploadedAt             DateTime  @default(now())
  sourceStorageKey       String? // Supabase Storage key (nullable for legacy rows)
  lastSyncAttemptAt      DateTime?
  lastSyncedAt           DateTime?
  lastSyncError          String?
  lastSyncTrigger        String? // 'SCHEDULED' | 'MANUAL'
  staleNoticeAt          DateTime? // scheduled sync skipped because the week has edits/decisions
  syncLockedAt           DateTime?
  approvedAt             DateTime?

  attendanceRecords  AttendanceRecord[]
  punches            AttendancePunch[]
  decisions          AttendanceEmployeeDecision[]
  correctionSessions PayrollCorrectionSession[]
}

model AttendancePunch {
  id                 String   @id @default(uuid())
  attendanceUploadId String
  correctionId       String? // null = live set; set = draft clone of a correction
  clonedFromPunchId  String? // live punch this correction clone was copied from
  employeeId         String? // null until the code is resolved
  empCode            String
  empName            String? // eTimeOffice name, reference only
  matchStatus        String // 'MATCHED' | 'UNKNOWN' | 'DUPLICATE' | 'IGNORED'
  punchDate          DateTime // UTC midnight of the wall-clock date
  pairIndex          Int
  position           String // 'IN' | 'OUT'
  source             String // 'API' | 'MANUAL'
  originalTime       String? // 'HH:mm' as received; null for MANUAL
  currentTime        String? // 'HH:mm'; null = deleted
  note               String?
  mergedScansJson    Json? // string[] of 'HH:mm' scans merged into this punch
  mcid               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attendanceUpload AttendanceUpload          @relation(fields: [attendanceUploadId], references: [id])
  employee         Employee?                 @relation(fields: [employeeId], references: [id])
  correction       PayrollCorrectionSession? @relation(fields: [correctionId], references: [id])

  @@index([attendanceUploadId, correctionId, employeeId, punchDate])
  @@index([attendanceUploadId, empCode])
}

model AttendanceEmployeeDecision {
  id                 String   @id @default(uuid())
  attendanceUploadId String
  employeeId         String
  reason             String // 'INACTIVE' | 'RESIGNED_BEFORE_WEEK'
  decision           String // 'APPROVED' | 'REJECTED'
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attendanceUpload AttendanceUpload @relation(fields: [attendanceUploadId], references: [id])
  employee         Employee         @relation(fields: [employeeId], references: [id])

  @@unique([attendanceUploadId, employeeId])
}

model AttendanceCodeException {
  id         String    @id @default(uuid())
  empCode    String    @unique
  kind       String // 'MATCH' | 'IGNORE'
  employeeId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee? @relation(fields: [employeeId], references: [id])
}

model PayrollCorrectionSession {
  id                     String    @id @default(uuid())
  payrollRunId           String
  attendanceUploadId     String
  status                 String // 'IN_PROGRESS' | 'APPLIED' | 'ABANDONED'
  correctionReason       String?
  correctionTypesJson    Json // CorrectionType[]
  adjustmentSnapshotJson Json? // [{ applicationId, approvalStatus, isReversed, approvedAt, skippedAt, appliedAt }]
  draftRevisionId        String?
  createdAt              DateTime  @default(now())
  appliedAt              DateTime?
  abandonedAt            DateTime?

  payrollRun       PayrollRun        @relation(fields: [payrollRunId], references: [id])
  attendanceUpload AttendanceUpload  @relation(fields: [attendanceUploadId], references: [id])
  punches          AttendancePunch[]

  @@index([payrollRunId, status])
}

model AttendanceRecord {
  id                       String   @id @default(uuid())
  attendanceUploadId       String
  employeeId               String
  attendanceDate           DateTime
  regularHours             Decimal  @db.Decimal(5, 2)
  overtimeHours            Decimal  @db.Decimal(5, 2)
  beforeNoonIn             String?
  beforeNoonOut            String?
  afternoonIn              String?
  afternoonOut             String?
  overtimeIn               String?
  overtimeOut              String?
  sourceSheetName          String?
  sourceEmployeeBlockIndex Int?
  verificationDecision     String?  // 'APPROVED' | 'REJECTED' | null = pending
  createdAt                DateTime @default(now())

  attendanceUpload AttendanceUpload @relation(fields: [attendanceUploadId], references: [id])
  employee         Employee         @relation(fields: [employeeId], references: [id])
}

model PayrollAdjustment {
  id                        String    @id @default(uuid())
  employeeId                String
  adjustmentType            String // "DEDUCTION" or "ADDITION"
  recurrenceType            String // "ONE_TIME" or "RECURRING"
  amount                    Decimal   @db.Decimal(10, 2)
  reason                    String
  startPayrollWeekStartDate DateTime
  startPayrollWeekEndDate   DateTime
  endPayrollWeekStartDate   DateTime?
  endPayrollWeekEndDate     DateTime?
  totalRecurrenceWeeks      Int?
  totalBalance              Decimal?  @db.Decimal(10, 2)
  remainingBalance          Decimal?  @db.Decimal(10, 2)
  recurrenceEndType         String? // "END_WEEK", "FIXED_WEEKS", "TOTAL_BALANCE"
  status                    String // e.g., "ACTIVE", "COMPLETED", "CANCELLED"
  skippedCarryForwardCount  Int       @default(0)
  createdBy                 String?
  createdAt                 DateTime  @default(now())

  employee               Employee                       @relation(fields: [employeeId], references: [id])
  adjustmentApplications PayrollAdjustmentApplication[]
}

model PayrollAdjustmentApplication {
  id                                   String    @id @default(uuid())
  payrollAdjustmentId                  String
  payrollRunId                         String?
  payrollRevisionId                    String?
  employeeId                           String
  payrollWeekStartDate                 DateTime
  payrollWeekEndDate                   DateTime
  appliedAmount                        Decimal   @db.Decimal(10, 2)
  approvalStatus                       String // "PENDING", "APPROVED", "SKIPPED"
  approvedBy                           String?
  approvedAt                           DateTime?
  appliedAt                            DateTime?
  skippedAt                            DateTime?
  carriedForwardToPayrollWeekStartDate DateTime?
  isReversed                           Boolean   @default(false)

  payrollAdjustment PayrollAdjustment @relation(fields: [payrollAdjustmentId], references: [id])
  employee          Employee          @relation(fields: [employeeId], references: [id])
  payrollRun        PayrollRun?       @relation(fields: [payrollRunId], references: [id])
  payrollRevision   PayrollRevision?  @relation(fields: [payrollRevisionId], references: [id])
}

model PayrollRun {
  id                    String    @id @default(uuid())
  payrollWeekStartDate  DateTime
  payrollWeekEndDate    DateTime
  status                String // "DRAFT", "APPROVED", "REVISED"
  currentRevisionNumber Int       @default(1)
  totalRegularPay       Decimal   @db.Decimal(12, 2)
  totalOvertimePay      Decimal   @db.Decimal(12, 2)
  totalAdditions        Decimal   @db.Decimal(12, 2)
  totalDeductions       Decimal   @db.Decimal(12, 2)
  totalNetPayable       Decimal   @db.Decimal(12, 2)
  generatedBy           String?
  approvedBy            String?
  generatedAt           DateTime  @default(now())
  approvedAt            DateTime?
  invoicesGeneratedAt   DateTime?

  revisions              PayrollRevision[]
  adjustmentApplications PayrollAdjustmentApplication[]
  runEmployees           PayrollRunEmployee[]
  invoiceSnapshots       InvoiceSnapshot[]
  correctionSessions     PayrollCorrectionSession[]
}

model PayrollRevision {
  id                  String    @id @default(uuid())
  payrollRunId        String
  revisionNumber      Int
  status              String // "DRAFT", "APPROVED", "SUPERSEDED"
  correctionReason    String?
  totalRegularPay     Decimal   @db.Decimal(12, 2)
  totalOvertimePay    Decimal   @db.Decimal(12, 2)
  totalAdditions      Decimal   @db.Decimal(12, 2)
  totalDeductions     Decimal   @db.Decimal(12, 2)
  totalNetPayable     Decimal   @db.Decimal(12, 2)
  generatedBy         String?
  approvedBy          String?
  generatedAt         DateTime  @default(now())
  approvedAt          DateTime?
  invoicesGeneratedAt DateTime?
  isCurrent           Boolean   @default(true)

  payrollRun             PayrollRun                     @relation(fields: [payrollRunId], references: [id])
  adjustmentApplications PayrollAdjustmentApplication[]
  runEmployees           PayrollRunEmployee[]
  invoiceSnapshots       InvoiceSnapshot[]
}

model PayrollRunEmployee {
  id                String  @id @default(uuid())
  payrollRunId      String
  payrollRevisionId String
  employeeId        String
  weeklySalaryUsed  Decimal @db.Decimal(10, 2)
  hourlyRateUsed    Decimal @db.Decimal(10, 2)
  regularHours      Decimal @db.Decimal(5, 2)
  overtimeHours     Decimal @db.Decimal(5, 2)
  regularPay        Decimal @db.Decimal(10, 2)
  overtimePay       Decimal @db.Decimal(10, 2)
  additions         Decimal @db.Decimal(10, 2)
  deductions        Decimal @db.Decimal(10, 2)
  netPayable        Decimal @db.Decimal(10, 2)

  payrollRun      PayrollRun      @relation(fields: [payrollRunId], references: [id])
  payrollRevision PayrollRevision @relation(fields: [payrollRevisionId], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id])
}

model InvoiceSnapshot {
  id                     String    @id @default(uuid())
  payrollRunId           String
  payrollRevisionId      String
  employeeId             String
  invoiceFormat          String // e.g., "PDF"
  invoiceSnapshotJson    Json
  generatedAt            DateTime  @default(now())
  temporaryFileDeletedAt DateTime?

  payrollRun      PayrollRun      @relation(fields: [payrollRunId], references: [id])
  payrollRevision PayrollRevision @relation(fields: [payrollRevisionId], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  actionType  String // "CREATE", "UPDATE", "DELETE", "SYNC", "PULL", "APPROVE", "REOPEN", "DISCARD"
  entityType  String // "EMPLOYEE", "WAGE_HISTORY", "ATTENDANCE_WEEK", "ATTENDANCE_PUNCH", "ATTENDANCE_DECISION", "ATTENDANCE_CODE"
  entityId    String
  detailsJson Json
  createdAt   DateTime @default(now())
}

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  documentType String
  expiryDate   DateTime?
  notes        String?
  filePath     String
  uploadedAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Settings {
  id                  String    @id @default("singleton")
  payrollWeekStartDay DayOfWeek @default(THURSDAY)
  updatedAt           DateTime  @updatedAt
}
