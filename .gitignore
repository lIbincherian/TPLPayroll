# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/test_output.txt

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*
!.env.example

# secrets
secrets

# vercel
.vercel

#supabase
supabase

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma


# Claude: the project's agents, skills, commands, helpers and settings are committed;
# machine-local state is not.
.claude/worktrees/
.claude/settings.local.json
.claude/*.bak*
# Downloaded on first run by the impeccable launcher (19 MB binary).
.claude/skills/impeccable/scripts/bin/
.claude-flow

# graphify
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_uncached.txt

# Software factory runtime state and job worktrees
/factory/jobs/
/.worktrees/
